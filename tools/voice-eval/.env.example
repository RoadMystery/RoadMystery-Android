# 이 파일을 같은 폴더에 .env 라는 이름으로 복사한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.
# 이 예시 파일(.env.example)에는 실제 키를 쓰지 마세요.

# Claude API 키. 비교 도구(run, summary)와 개발용 프록시(proxy)가 씁니다.
ANTHROPIC_API_KEY=

# 개발용 프록시와 데모 앱이 함께 쓰는 앱 토큰. 공백 없는 영문·숫자 16자 이상으로 정하세요.
# 프록시와 데모 앱 빌드가 둘 다 이 값을 읽습니다. 바꾸면 데모 앱을 다시 빌드하세요.
VOICE_PROXY_TOKEN=

# 데모 앱이 프록시 없이 Claude를 직접 부를 때 쓰는 데모 전용 키. 위 ANTHROPIC_API_KEY와는 다른 키를 쓰세요.
# 이 키는 디버그 APK 안에 들어갑니다. 콘솔에서 사용 한도를 낮게 건 키만 넣고, 비워 두면 데모 앱은 프록시를 씁니다.
DEMO_ANTHROPIC_API_KEY=
