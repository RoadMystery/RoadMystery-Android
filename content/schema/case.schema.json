{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case.schema.json",
  "title": "사건(Case)",
  "description": "시나리오 하나의 공개 사실, 등장인물, 단서, 정답. 단서 ID는 StoryEngine의 pendingClues/획득 단서와 같은 값을 쓴다.",
  "type": "object",
  "required": ["id", "title", "theme", "setting", "publicFacts", "cast", "clues", "solution", "spoilerGuard"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "placeholder": { "type": "boolean", "description": "true면 시연 원고가 확정되기 전 테스트용 임시 사건" },
    "placeholderNote": { "type": "string" },
    "theme": { "enum": ["family", "general"], "description": "family면 폭력 묘사를 제한한다" },
    "setting": { "type": "string", "minLength": 1 },
    "publicFacts": {
      "description": "게임 시작부터 모두가 아는 사실. 모든 용의자 프롬프트에 들어간다.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "cast": { "type": "array", "items": { "$ref": "#/$defs/castMember" }, "minItems": 1 },
    "clues": { "type": "array", "items": { "$ref": "#/$defs/clue" } },
    "solution": {
      "description": "정답. 용의자 프롬프트에는 넣지 않고(진실 포함 변형 제외) 채점에만 쓴다.",
      "type": "object",
      "required": ["culprit", "method", "motive", "hidingPlace"],
      "additionalProperties": false,
      "properties": {
        "culprit": { "type": "string", "description": "cast의 id" },
        "method": { "type": "string" },
        "motive": { "type": "string" },
        "hidingPlace": { "type": "string" },
        "hiddenFacts": { "$ref": "#/$defs/hiddenFacts" }
      }
    },
    "spoilerGuard": {
      "type": "object",
      "required": ["forbiddenPhrases"],
      "additionalProperties": false,
      "properties": {
        "forbiddenPhrases": {
          "description": "결말 전 어떤 답변에도 나오면 안 되는 표현. 공백을 무시하고 부분 일치로 검사한다.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "hint": {
          "description": "단서를 모두 찾았고 끌어낼 핵심 반응이 남지 않았을 때 진행자가 하는 힌트(추리 방향만). 용의자 답이 정답을 흘리려다 끊기거나 플레이어가 범인·정답을 물을 때 쓴다. LLM에는 보내지 않는다. 금지 표현을 쓰지 않는다.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "castMember": {
      "type": "object",
      "required": ["id", "name", "role", "isSuspect", "aliases", "publicDescription"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "isSuspect": { "type": "boolean" },
        "aliases": {
          "description": "음성 질문에서 이 인물을 가리키는 말. 용의자 판별에 쓴다.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "publicDescription": { "type": "string" }
      }
    },
    "clue": {
      "type": "object",
      "required": ["id", "title", "summary", "chapter", "keywords"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^clue-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "chapter": { "type": "integer", "minimum": 1 },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "hiddenFacts": { "$ref": "#/$defs/hiddenFacts" },
        "hint": {
          "description": "이 단서를 아직 못 찾았을 때 진행자가 하는 힌트. 용의자 답이 단서나 정답을 흘리려다 끊기거나 플레이어가 범인·정답을 물었는데, 끌어낼 수 있는 핵심 반응이 없을 때 쓴다(docs/voice-agent/investigation-progress.md). 무엇을 눈여겨볼지만 말하고, 어느 단서의 키워드도, 다른 단서의 제목·mentions도, 금지 표현도, 숨길 사실도 쓰지 않는다. LLM에는 보내지 않는다. 이 단서에 힌트가 없으면 힌트가 있는 다른 못 찾은 단서의 힌트를 쓰고, 하나도 없으면 첫 문장이 끊긴 턴만 용의자의 화제 돌리기 대사로 대신한다.",
          "type": "string",
          "minLength": 1
        },
        "mentions": {
          "description": "키워드와 제목 말고도 플레이어 질문이 이 단서를 꺼냈다고 볼 말. 수사 진척도의 '추궁'을 셀 때만 쓰고 LLM에는 보내지 않는다. 공백을 무시하고 부분 일치로 찾으므로 한 글자 말은 쓰지 않는다(창 → 창고).",
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "uniqueItems": true
        }
      }
    },
    "hiddenFacts": {
      "description": "플레이어가 찾기 전에는 용의자가 말하면 안 되는 사실을 한 문장에 하나씩. 공개 사실이나 용의자가 말해도 되는 사실과 겹치는 내용(예: 집사의 알리바이)은 넣지 않는다. 문장 판별이 이 목록과 비교한다.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  }
}
